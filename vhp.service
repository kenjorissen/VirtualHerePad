[Unit]
Description=VirtualHere Pad
After=network.target
RequiresMountsFor=/home/.vhp

[Service]
Type=simple
WorkingDirectory=/home/.vhp/data
RuntimeDirectory=vhp
RuntimeDirectoryMode=0700
# sleep: keep the Deck awake while sharing. idle: stop the screen blanking out
# from under the dashboard and the touch keyboard. Both are released on exit.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --mode=block --who=VHP "--why=Sharing Steam Deck controller" /home/.vhp/bin/vhp-root run
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

# Deliberately not enabled at boot: the Steam launcher controls its lifetime.
