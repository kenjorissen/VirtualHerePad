[Unit]
Description=VirtualHere Pad
After=network.target
RequiresMountsFor=/home/.vhp

[Service]
Type=simple
WorkingDirectory=/home/.vhp/data
RuntimeDirectory=vhp
# Traverse only: the GUI socket is owner-only; the lease/markers remain root-only.
RuntimeDirectoryMode=0711
# Advisory inhibitors: compositor-specific blanking policies may differ.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --mode=block --who=VHP "--why=Sharing Steam Deck controller" /home/.vhp/bin/vhp-root run
ExecStopPost=/home/.vhp/bin/vhp-root cleanup
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

# Deliberately not enabled at boot: the Steam launcher controls its lifetime.
